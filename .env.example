# OnchainSUB — example environment file.
#
# Copy to `.env` and replace every placeholder with your own values:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets — this template must stay
# placeholder-only so the repository remains safe to publish.

# --- Postgres (backend invoice storage) ---
POSTGRES_USER=onchainsub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onchainsub

# --- Solana RPC (devnet only in this prototype) ---
CLUSTER=devnet
# Use your own provider endpoint/key. The public devnet RPC needs no key:
#   https://api.devnet.solana.com
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
SOLANA_TESTNET_RPC=https://api.testnet.solana.com

# --- Helius (optional paid RPC + webhooks) ---
# Read from the environment by the demo bootstrap scripts; never hardcode it.
HELIUS_API_KEY=your-helius-api-key
HELIUS_WEBHOOK_SECRET=your-webhook-signing-secret

# --- Outbound mail (invoice notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=change-me
SMTP_FROM=no-reply@example.com
MAIL_FROM_NAME=OnchainSUB
# Token guarding the test-mail endpoint; generate a random value.
MAIL_TEST_TOKEN=change-me-test-token

# --- Media store (RustFS, S3-compatible) ---
RUSTFS_ACCESS_KEY=change-me-access-key
RUSTFS_SECRET_KEY=change-me-secret-key

# --- Frontend (build-time) ---
# Public site URL is baked into the frontend bundle at build time.
PUBLIC_SITE_URL=https://solhack.rafal.si
# Server-side only; inside Compose this is the backend service name.
BACKEND_URL=http://backend:3001
