                  <p class="font-mono text-[11px] tracking-wider text-[#ffb4ab]/70 uppercase" data-i18n="flows2.outageKicker">HTTP 502 · MOCK</p>
                  <h2 class="font-display mt-1 text-2xl font-bold tracking-tight text-[#7df4ff]" data-i18n="flows2.outageTitle">Checkout unavailable — API outage</h2>
                  <p class="mt-1 text-sm leading-relaxed text-white/55" data-i18n="paysim.fallbackNote">
                    Preview of an outage: the domain-bind service is unreachable (502), so the popup cannot prove the host.
                    The merchant backup is a direct Blink URL — same plan, same one-period approve cap, no hosted checkout
                    needed.
                  </p>
                </div>
              </div>
            </div>
            <div class="space-y-3 rounded-b-xl bg-[#191b25] p-4 text-sm leading-relaxed text-white/60">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] tracking-wider text-[#00f0ff] uppercase" data-i18n="port4.emergencyMode">EMERGENCY MODE: DIRECT ON-CHAIN RPC</span>
                <span class="rounded bg-[#14f195]/10 px-2 py-0.5 font-mono text-[11px] text-[#14f195]" data-i18n="port4.noMiddleman">NO MIDDLEMAN</span>
              </div>
              <!-- Direct route card (reference pattern) — real values from the
                   request/RPC env only. -->
              <div class="space-y-1.5 rounded-xl bg-[#1d1f29] p-4">
                <div class="flex items-center justify-between gap-2 rounded bg-[#32343f]/20 px-2 py-1 font-mono text-[13px]">
                  <span class="shrink-0 text-white/40" data-i18n="paysim.routeProgram">Program</span>
                  <span class="truncate text-white/90">{PROGRAM_ID.toBase58()}</span>
                </div>
                <div class="flex items-center justify-between gap-2 rounded bg-[#32343f]/20 px-2 py-1 font-mono text-[13px]">
                  <span class="shrink-0 text-white/40" data-i18n="paysim.routeRpc">RPC endpoint</span>
                  <span class="truncate text-[#56ffa8]">{displayRpc}</span>
                </div>
                <div class="flex items-center justify-between gap-2 rounded bg-[#32343f]/20 px-2 py-1 font-mono text-[13px]">
                  <span class="shrink-0 text-white/40" data-i18n="paysim.routeAmount">Amount</span>
                  <span class="truncate font-semibold text-white/90">{amountUi} (on-chain)</span>
                </div>
              </div>
              <!-- Self-hosted Actions: the backup path is our own endpoint. A
                   plain GET renders the action metadata JSON; wallets consume
                   the same URL behind solana-action: — no gateway in between. -->
              <a
                href={fullActionUrl}
                target="_blank"
                rel="noreferrer"
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#00838c] py-4 font-display text-sm font-semibold text-white transition-colors hover:bg-[#00dbe9] hover:text-[#00363a]"
              >
                <span class="msym text-[20px]" aria-hidden="true">data_object</span>
                <span data-i18n="paysim.openEndpoint">Open actions endpoint</span>
              </a>
              <ol class="list-decimal space-y-1 pl-5">
                <li data-i18n="paysim.fallbackStep1">Copy the direct Action URL for this plan.</li>
                <li data-i18n="paysim.fallbackStep2">Paste it into any wallet as a solana-action: link — no gateway needed.</li>
                <li data-i18n="paysim.fallbackStep3">
                  The wallet signs the same approve-capped transaction — the subscriber never pays more than one period.
                </li>
              </ol>
              <pre class="codeblock mt-3 overflow-x-auto p-3 font-mono text-[11px] break-all whitespace-pre-wrap">{fullActionUrl}</pre>
              <div class="mt-3 flex flex-wrap gap-2">
                <button
                  id="copy-fallback"
                  type="button"
                  class="btn-ghost cursor-pointer rounded-lg px-4 py-2 text-sm"
                  data-url={fullActionUrl}
                  data-i18n="paysim.copyBlink"
                >
                  Copy Blink URL
                </button>
                <a href="/blink" class="btn-ghost rounded-lg px-4 py-2 text-sm" data-i18n="paysim.openBlink">
                  Open Blink builder
                </a>
              </div>
              <p id="copy-fallback-status" class="mt-2 min-h-4 font-mono text-[11px] text-white/40" role="status"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: cryptographic proof (mechanics) + live check -->
      <div class="grid content-start gap-4">
        <div class="space-y-6 rounded-xl bg-[#191b25] p-6 shadow-xl">
          <div class="flex items-center justify-between rounded-t-xl bg-[#282934]/40 px-2 pt-1">
            <div class="flex min-w-0 items-center gap-2">
              <span class="msym shrink-0 text-[20px] text-[#00dbe9]" aria-hidden="true">enhanced_encryption</span>
              <h2 class="font-display text-lg font-bold" data-i18n="paysim.proofTitle">How the checkout is protected</h2>
            </div>
            <span class="shrink-0 rounded bg-[#14f195]/10 px-2 py-0.5 font-mono text-[10px] text-[#14f195]" data-i18n="paysim.proofBadge">
              mechanics, not metrics
            </span>
          </div>
          <ol class="space-y-4">
            <li class="flex items-start gap-3 rounded-xl bg-[#1d1f29] p-3">
              <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#282934] font-mono text-[12px] font-semibold text-[#00f0ff]">01</div>
              <div class="space-y-1">
                <p class="font-semibold text-white/85" data-i18n="paysim.step1t">1. Merchant domain registration</p>
                <p class="text-[13px] leading-relaxed text-white/60" data-i18n="paysim.step1b">
                  The merchant binds their domain to a plan off-chain (POST /api/widget/sites). The server gate compares
                  the checkout host against that binding on every load — a foreign host ends at 403.
                </p>
                <!-- Real PDA seeds, DESIGN.md §3 (plan account). -->
                <div class="rounded bg-[#0c0e17] p-2 font-mono text-[11px] break-all text-white/40">seeds: [b"plan", merchant, plan_id.le]</div>
              </div>
            </li>
            <li class="flex items-start gap-3 rounded-xl bg-[#1d1f29] p-3">
              <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#282934] font-mono text-[12px] font-semibold text-[#d8b9ff]">02</div>
              <div class="space-y-1">
                <p class="font-semibold text-white/85" data-i18n="paysim.step2t">2. Origin &amp; iframe validation</p>
                <p class="text-[13px] leading-relaxed text-white/60" data-i18n="paysim.step2b">
                  The popup URL carries ?plan=&lt;address&gt;&amp;host=&lt;domain&gt;. The server re-checks the pair before
                  serving the checkout. A copied snippet on another domain fails this check even though the markup is
                  identical.
                </p>
                {status === 200 && !isDemoPlan && (
                  <div class="flex min-w-0 flex-col gap-1">
                    <!-- ?host= is declared by whoever crafted the URL: the server
                         /check only answers about that param, never about the
                         page that opened this popup — a declared value, not a
                         verified identity. The script below warns on opener
                         mismatch. -->
                    <div class="flex items-center gap-1 font-mono text-[11px] text-white/55">
                      <span class="msym shrink-0 text-[14px]" aria-hidden="true">info</span>
                      <span class="truncate"><span data-i18n="paysim.declaredHostLabel">DECLARED HOST:</span> {hostParam || "—"}</span>
                    </div>
                    <p
                      id="host-trust-warning"
                      class="hidden rounded bg-[#ffb4ab]/10 p-2 font-mono text-[11px] leading-relaxed text-[#ffb4ab]"
                      data-i18n="paysim.hostMismatchWarning"
                    >
                      Warning: this popup was opened from a different site than the declared host — verify the address
                      before paying.
                    </p>
                  </div>
                )}
              </div>
            </li>
            <li class="flex items-start gap-3 rounded-xl bg-[#1d1f29] p-3">
              <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#282934] font-mono text-[12px] font-semibold text-[#14f195]">03</div>
              <div class="space-y-1">
                <p class="font-semibold text-white/85" data-i18n="paysim.step3t">3. SPL allowance & zero custody</p>
                <p class="text-[13px] leading-relaxed text-white/60" data-i18n="paysim.step3b">
                  Subscribing signs an approve capped at exactly one period plus subscribe, atomically. The delegate can
                  only pay the plan merchant — a domain thief has no path to your funds.
                </p>
              </div>
            </li>
          </ol>
          <div class="space-y-2 rounded-xl bg-[#0c0e17] p-4">
            <div class="flex items-center justify-between gap-2 font-mono text-[11px]">
              <span class="min-w-0 tracking-wider text-white/35 uppercase" data-i18n="paysim.memoTitle">RAW PLAN MEMO (live from chain):</span>
              {status === 200 && !isDemoPlan ? (
                <span class="shrink-0 rounded bg-[#00ec91]/20 px-2 py-0.5 text-[10px] tracking-[0.06em] text-[#56ffa8] uppercase" data-i18n="paysim.memoStateLive">LOADED FROM RPC</span>
              ) : isDemoPlan ? (
                <span class="chip-pastdue shrink-0" data-i18n="paysim.memoStateDemo">DEMO FIXTURE</span>
              ) : (
                <span class="shrink-0 rounded bg-white/5 px-2 py-0.5 text-[10px] tracking-[0.06em] text-white/40 uppercase" data-i18n="paysim.memoStateError">UNAVAILABLE</span>
              )}
            </div>
            {
              status === 200 && !isDemoPlan ? (
                <pre class="overflow-x-auto rounded bg-[#1d1f29] p-2 font-mono text-[11px] leading-relaxed break-all whitespace-pre-wrap text-[#00f0ff]">{`{
  "program": "${PROGRAM_ID.toBase58()}",
  "plan": "${planParam}",
  "merchant": "${merchantAddr}",
  "amount_raw": "${amountRaw}",
  "host": "${hostParam}"
}`}</pre>
              ) : isDemoPlan ? (
                <pre class="overflow-x-auto rounded bg-[#1d1f29] p-2 font-mono text-[11px] leading-relaxed break-all whitespace-pre-wrap text-[#ffb4ab]/90">{`{
  "program": "DEMO — no chain read",
  "plan": "${demoAddress}",
  "merchant": "${demo0 === undefined ? "—" : demo0.merchant}",
  "amount": "${demo0 === undefined ? "—" : `${demo0.amountUi} ${demo0.mintSymbol}`}"
}`}</pre>
              ) : (
                <p class="mt-2 font-mono text-[11px] text-white/40" data-i18n="paysim.memoEmpty">
                  No on-chain memo — the plan failed to load (see live status above).
                </p>
              )
            }
          </div>
          <!-- FAQ card (reference pattern; keys reused, zero i18n debt) -->
          <div class="space-y-2 rounded-xl bg-[#1d1f29] p-5">
            <div class="flex min-w-0 items-center gap-2 text-white/90">
              <span class="msym shrink-0 text-[20px] text-[#d8b9ff]" aria-hidden="true">help_outline</span>
              <span class="font-display text-base font-bold" data-i18n="paysim.whyTitle">Why a domain thief gets nothing</span>
            </div>
            <p class="text-[13px] leading-relaxed text-white/60" data-i18n="paysim.whyBody">
              Even if an attacker copies the whole iframe onto a prepared lookalike page, the on-chain delegate pays
              only the merchant stored in the plan account. The stolen snippet renders a 403 page and can never move
              funds.
            </p>
          </div>
        </div>

        <!-- Metric pair — real constants only: the on-chain FEE_BPS (fees.rs)
             and the host param under check. Reference mock metrics (spoofing
             rate, fake signatures) are intentionally not ported. -->
        <div class="grid grid-cols-2 gap-4">
          <div class="min-w-0 space-y-1 rounded-xl bg-[#191b25] p-4">
            <div class="flex items-center gap-1.5 text-[#56ffa8]">
              <span class="msym shrink-0 text-[18px]" aria-hidden="true">payments</span>
              <span class="font-mono text-[11px] tracking-[0.06em] uppercase" data-i18n="paysim.feeMetric">COLLECTION FEE</span>
            </div>
            <div class="font-display text-xl font-bold text-white">40 bps</div>
            <div class="text-xs leading-relaxed text-white/40" data-i18n="paysim.feeMetricSub">0.4% of every charge — on-chain constant (FEE_BPS)</div>
          </div>
          <div class="min-w-0 space-y-1 rounded-xl bg-[#191b25] p-4">
            <div class="flex items-center gap-1.5 text-[#00dbe9]">
              <span class="msym shrink-0 text-[18px]" aria-hidden="true">dns</span>
              <span class="font-mono text-[11px] tracking-[0.06em] uppercase" data-i18n="paysim.bindMetric">DOMAIN-BIND</span>
            </div>
            <div class="truncate font-mono text-sm font-semibold text-white/90">{hostParam === "" ? "—" : hostParam}</div>
            <div class="text-xs leading-relaxed text-white/40" data-i18n="paysim.bindMetricSub">Host the server gate checks on every load</div>
          </div>
        </div>

        <div class="rounded-xl bg-[#191b25] p-5 text-sm leading-relaxed text-white/60 shadow-xl">
          <h2 class="font-display text-base font-bold text-white/85" data-i18n="paysim.legendTitle">
            What is live vs mocked on this page
          </h2>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-[13px]">
            <li data-i18n="paysim.legendLive">
              Live: the authorized-domain checkout, plan/merchant/amount loaded from RPC, and the domain-bind check below.
            </li>
            <li data-i18n="paysim.legendMock">
              Mock: the phishing 403 and outage 502 panels — static previews, explicitly badged, moving no funds.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
  )}
</Layout>

<script>
  import { initPayCheckout } from "../lib/pay-checkout.js";
  import { isDemoMode } from "../lib/demo.js";
  import { RPC_ENDPOINT, explorerTxUrl } from "../lib/chain.js";
  import { notifyOpenerPaid, payOneTime, payStatusText } from "../lib/payments.js";
  import type { SolanaProvider } from "../lib/wallet.js";
  import "../lib/i18n-flows2.js";
  import "../lib/i18n-pay.js";
  import "../lib/i18n-port4.js";

  // Storage-only demo flag is invisible to the server — normalize to ?demo=1
  // so the server can serve fixtures instead of fetching.
  try {
    const qs = new URLSearchParams(window.location.search);
    if (isDemoMode() && !qs.has("demo")) {
      qs.set("demo", "1");
      window.location.replace(`${window.location.pathname}?${qs.toString()}`);
    }
  } catch {
    /* private mode — session-only */
  }

  // The SSR markup carries no RPC host (the backend-internal default must
  // never leak into the public HTML). Resolve the browser-side endpoint here,
  // before the checkout lib reads it: chain.js evaluates to the same-origin
  // /api/rpc proxy in the browser, or the PUBLIC_SOLANA_RPC override if set.
  const paySubscribeBtn = document.getElementById("pay-subscribe");
  if (paySubscribeBtn instanceof HTMLButtonElement) paySubscribeBtn.dataset.rpc = RPC_ENDPOINT;

  initPayCheckout();

  // ?host= is untrusted input: /check only answers about the declared param,
  // so the page cannot show the *registered* domain. Warn when this popup was
  // opened from a different site than the declared host — document.referrer
  // carries the opener URL (window.opener.origin is unreadable cross-origin).
  (function warnHostMismatch(): void {
    const warning = document.getElementById("host-trust-warning");
    if (warning === null) return;
    const declared = document.querySelector<HTMLElement>("#live-check")?.dataset.host ?? "";
    if (declared === "") return;
    let refHost = "";
    try {
      refHost = new URL(document.referrer).hostname;
    } catch {
      return; // no usable referrer → nothing to verify, stay silent
    }
    // A port on the declared value (local dev) must not fake a mismatch.
    const declaredHost = declared.replace(/:\d+$/, "");
    if (refHost !== "" && refHost !== declaredHost) warning.classList.remove("hidden");
  })();

  // Tabs switch ONLY the preview column — the server gate is never re-hit.
  const panels: Record<string, HTMLElement | null> = {
    ok: document.getElementById("sim-ok"),
    phishing: document.getElementById("sim-phishing"),
    fallback: document.getElementById("sim-fallback"),
  };
  const isPl = (): boolean => document.documentElement.lang === "pl";
  const T = {
    demo: (): string => (isPl() ? "DEMO — dozwolone: tak (fixture, bez fetcha)" : "DEMO — allowed: true (fixture, no fetch)"),
    needs: (): string => (isPl() ? "— (potrzebne ?plan=<adres>&host=<domena>)" : "— (needs ?plan=<address>&host=<domain>)"),
    unreachable: (s: number): string =>
      isPl() ? `nieosiągalny (HTTP ${s})` : `unreachable (HTTP ${s})`,
    netErr: (): string => (isPl() ? "nieosiągalny (błąd sieci)" : "unreachable (network error)"),
    live: (ok: boolean, s: number): string =>
      isPl()
        ? `dozwolone: ${ok ? "tak" : "nie"} (live, HTTP ${s})`
        : `allowed: ${ok ? "true" : "false"} (live, HTTP ${s})`,
    copied: (): string => (isPl() ? "Skopiowano." : "Copied."),
    clipBlocked: (): string =>
      isPl() ? "Schowek zablokowany — skopiuj ręcznie." : "Clipboard blocked — copy manually.",
  };
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-sim-tab]"));

  const stateEl = document.getElementById("sim-state");
  const stateTextEl = document.getElementById("sim-state-text");

  // Per-mode accents (Stitch pattern): live = emerald, 403 = error, 502 = cyan.
  const pillPalette: Record<string, string[]> = {
    ok: ["bg-[#56ffa8]/20", "text-[#56ffa8]"],
    phishing: ["bg-[#93000a]", "text-[#ffb4ab]"],
    fallback: ["bg-[#00838c]/30", "text-[#7df4ff]"],
  };
  const tabAccent: Record<string, string[]> = {
    phishing: ["bg-[#93000a]", "text-[#ffdad6]"],
    fallback: ["bg-[#00838c]", "text-white"],
  };

  function selectTab(name: string): void {
    for (const [key, panel] of Object.entries(panels)) {
      if (panel !== null) panel.hidden = key !== name;
    }
    for (const tab of tabs) {
      const mode = tab.dataset.simTab ?? "";
      const active = mode === name;
      tab.setAttribute("aria-selected", active ? "true" : "false");
      // Roving tabindex (WAI-ARIA tabs): only the active tab is in Tab order;
      // Arrow keys move both focus and selection.
      tab.tabIndex = active ? 0 : -1;
      tab.classList.toggle("btn-primary", active && mode === "ok");
      tab.classList.toggle("btn-ghost", !active);
      const accent = tabAccent[mode];
      if (accent !== undefined) {
        for (const cls of accent) tab.classList.toggle(cls, active);
      }
    }
    if (stateEl !== null) {
      for (const palette of Object.values(pillPalette)) {
        for (const cls of palette) stateEl.classList.remove(cls);
      }
      const palette = pillPalette[name] ?? pillPalette["ok"];
      if (palette !== undefined) {
        for (const cls of palette) stateEl.classList.add(cls);
      }
    }
    // Write the label only into the inner span — the outer pill carries the
    // pulsing dot and must never be clobbered (same rule as i18n.ts live text).
    if (stateTextEl !== null) {
      stateTextEl.textContent = name === "ok"
        ? isPl()
          ? "LIVE — prawdziwa bramka serwerowa"
          : "LIVE — real server gate"
        : isPl()
          ? "PODGLĄD MOCK — bramka nietknięta"
          : "MOCK PREVIEW — server gate untouched";
    }
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      selectTab(tab.dataset.simTab ?? "ok");
    });
  }
  // Arrow-key support on the tablist (WAI-ARIA tabs pattern): Left/Right move
  // to the previous/next tab (wrapping), Home/End jump to the first/last.
  const tablist = tabs[0]?.parentElement ?? null;
  tablist?.addEventListener("keydown", (e) => {
    const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
    if (current === -1) return;
    let next = -1;
    if (e.key === "ArrowRight") next = (current + 1) % tabs.length;
    else if (e.key === "ArrowLeft") next = (current - 1 + tabs.length) % tabs.length;
    else if (e.key === "Home") next = 0;
    else if (e.key === "End") next = tabs.length - 1;
    if (next === -1) return;
    e.preventDefault();
    const target = tabs[next];
    if (target === undefined) return;
    selectTab(target.dataset.simTab ?? "ok");
    target.focus();
  });
  selectTab("ok");

  // Live domain-bind check for the current host (proxied /api → backend).
  async function liveCheck(): Promise<void> {
    const el = document.getElementById("live-check");
    if (!(el instanceof HTMLElement)) return;
    const plan = el.dataset.plan ?? "";
    const host = el.dataset.host ?? "";
    const demo = el.dataset.demo === "1";
    if (demo) {
      el.textContent = T.demo();
      return;
    }
    if (plan === "" || host === "") {
      el.textContent = T.needs();
      return;
    }
    try {
      const res = await fetch(
        `/api/widget/check?plan=${encodeURIComponent(plan)}&host=${encodeURIComponent(host)}`,
      );
      const json = (await res.json()) as { allowed?: boolean };
      el.textContent = res.ok ? T.live(json.allowed === true, res.status) : T.unreachable(res.status);
    } catch {
      el.textContent = T.netErr();
    }
  }
  void liveCheck();

  let copyResetTimer = 0;
  document.getElementById("copy-fallback")?.addEventListener("click", async () => {
    const btn = document.getElementById("copy-fallback");
    const status = document.getElementById("copy-fallback-status");
    const url = btn instanceof HTMLElement ? (btn.dataset.url ?? "") : "";
    if (url === "") return;
    try {
      await navigator.clipboard.writeText(url);
      if (status !== null) status.textContent = T.copied();
    } catch {
      // Clipboard API can be blocked (permissions/context) — say so instead of
      // pasting the raw URL as if it were a success message.
      if (status !== null) status.textContent = T.clipBlocked();
    }
    // Auto-reset: a stale "Copied." must not outlive the action.
    window.clearTimeout(copyResetTimer);
    copyResetTimer = window.setTimeout(() => {
      if (status !== null) status.textContent = "";
    }, 2000);
  });

  // Merchant row copy-verify (address poisoning): copies the FULL address so
  // it can be checked against the wallet before signing.
  document.getElementById("copy-merchant")?.addEventListener("click", async () => {
    const btn = document.getElementById("copy-merchant");
    const status = document.getElementById("pay-status");
    const addr = btn instanceof HTMLElement ? (btn.dataset.addr ?? "") : "";
    if (addr === "") return;
    try {
      await navigator.clipboard.writeText(addr);
      if (status !== null) {
        status.textContent = isPl() ? "Adres merchanta skopiowany — zweryfikuj go w portfelu." : "Merchant address copied — verify it in your wallet.";
        status.style.color = "#56ffa8";
      }
    } catch {
      if (status !== null) status.textContent = T.clipBlocked();
    }
  });

  // -----------------------------------------------------------------------
  // ONE-TIME MODE (?mode=pay): elements below exist only in that markup —
  // every lookup is null-guarded, so the subscription flow is untouched.
  // -----------------------------------------------------------------------

  function payModeProvider(): SolanaProvider | null {
    if (typeof window === "undefined") return null;
    return window.solana ?? window.solflare ?? null;
  }

  function setPayStatus(text: string, isError: boolean): void {
    const el = document.getElementById("pay1-status");
    if (el === null) return;
    el.textContent = text;
    el.style.color = isError ? "#fda4af" : "rgba(255,255,255,0.6)";
  }

  // Copy-verify for the one-time card's merchant row (same rule as above).
  document.getElementById("pay1-copy-merchant")?.addEventListener("click", async () => {
    const btn = document.getElementById("pay1-copy-merchant");
    const addr = btn instanceof HTMLElement ? (btn.dataset.addr ?? "") : "";
    if (addr === "") return;
    try {
      await navigator.clipboard.writeText(addr);
      setPayStatus(
        isPl() ? "Adres merchanta skopiowany — zweryfikuj go w portfelu." : "Merchant address copied — verify it in your wallet.",
        false,
      );
    } catch {
      setPayStatus(T.clipBlocked(), true);
    }
  });

  // Solana Pay row: copies the SSR-built transfer-request URL (element exists
  // only when recipient + UI amount were known — null-guarded like the above).
  document.getElementById("pay1-copy-solpay")?.addEventListener("click", async () => {
    const btn = document.getElementById("pay1-copy-solpay");
    const url = btn instanceof HTMLElement ? (btn.dataset.url ?? "") : "";
    if (url === "") return;
    try {
      await navigator.clipboard.writeText(url);
      setPayStatus(
        isPl() ? "URL Solana Pay skopiowany — otwórz go w portfelu." : "Solana Pay URL copied — open it in your wallet.",
        false,
      );
    } catch {
      setPayStatus(T.clipBlocked(), true);
    }
  });

  const payOneBtn = document.getElementById("pay1-send");
  if (payOneBtn instanceof HTMLButtonElement) {
    payOneBtn.addEventListener("click", () => {
      void (async () => {
        const ds = payOneBtn.dataset;
        const merchant = ds.merchant ?? "";
        const amountRaw = ds.amount ?? "";
        const mint = ds.mint ?? "";
        if (merchant === "" || !/^\d+$/.test(amountRaw)) return;
        const provider = payModeProvider();
        if (provider === null) {
          setPayStatus(payStatusText("pay1.statusNoWallet", "No wallet found — install Phantom or Solflare."), true);
          return;
        }
        payOneBtn.disabled = true;
        try {
          setPayStatus(payStatusText("pay1.statusBuilding", "Building transaction… confirm in your wallet."), false);
          const result = await payOneTime({
            merchant,
            amount: BigInt(amountRaw),
            ...(mint !== "" ? { mint } : {}),
            ...(ds.label ? { label: ds.label } : {}),
            ...(ds.memo ? { memo: ds.memo } : {}),
          });
          // Confirmation screen: real signature + Explorer deep link.
          const sigEl = document.getElementById("pay1-sig");
          if (sigEl !== null) sigEl.textContent = result.signature;
          const link = document.getElementById("pay1-explorer");
          if (link instanceof HTMLAnchorElement) link.href = explorerTxUrl(result.signature);
          document.getElementById("pay1-success")?.classList.remove("hidden");
          // Honest receipt note: the transfer is final even when recording failed.
          if (!result.recorded) document.getElementById("pay1-record-warn")?.classList.remove("hidden");
          setPayStatus(payStatusText("pay1.statusPaid", "Paid — signature {signature}", { signature: result.signature }), false);
          // Popup flow (SolhackPay.pay): notify the SSR-validated ?host= origin;
          // the opener closes this popup on solhack:paid. Standalone links keep
          // the confirmation screen above.
          notifyOpenerPaid(result.signature);
        } catch (err) {
          setPayStatus(
            err instanceof Error ? err.message : payStatusText("pay1.statusFailed", "Payment failed."),
            true,
          );
          payOneBtn.disabled = false;
        }
      })();
    });
  }
</script>
