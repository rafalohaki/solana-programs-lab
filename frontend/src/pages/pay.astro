---
import Layout from "../layouts/Layout.astro";
import { Connection, PublicKey } from "@solana/web3.js";
import {
  CLUSTER,
  PROGRAM_ID,
  RPC_ENDPOINT,
  decodePlan,
  fetchMintDecimals,
  formatPeriod,
  formatTokenAmount,
  readEnv,
  shortAddr,
} from "../lib/chain.js";
import { SITE_URL } from "../lib/blinks.js";
import { DEMO_PLANS } from "../lib/demo.js";
import { buildTransferUrl } from "../lib/solanapay.js";

export const prerender = false;
// Query-dependent checkout HTML (?plan/?host/?demo → per-request gate status
// 200/400/403/404/502): never let an edge or browser cache serve one visitor
// another visitor's rendered checkout state.
Astro.response.headers.set("Cache-Control", "no-store");

// ---------------------------------------------------------------------------
// Server gate (untouched logic): ?plan=<address>&host=<domain> → widget check
// → RPC plan load. Demo mode (?demo=1) renders DEMO_PLANS[0] fixtures INSTEAD
// of any fetch, per the global demo rule. The simulator tabs below switch
// ONLY the client preview — they never re-hit this gate.
// ---------------------------------------------------------------------------

function backendBase(): string {
  const raw = process.env["BACKEND_URL"] ?? "http://backend:3001";
  return raw.replace(/\/+$/, "");
}

const planParam = (Astro.url.searchParams.get("plan") ?? "").trim();
const hostParam = (Astro.url.searchParams.get("host") ?? "").trim();
const demoParam = Astro.url.searchParams.get("demo") === "1";
// One-time payment mode (?mode=pay): bypasses the plan/domain-bind gate — a
// direct transfer needs no plan account and no host binding. Validated below,
// rendered as its own card; the subscription checkout markup is untouched.
const payMode = (Astro.url.searchParams.get("mode") ?? "").trim() === "pay";

let status: number = 200;
let headline: string = "";
let detail: string = "";
// i18n keys for the SSR error card (EN baked server-side; PL swaps client-side
// via data-i18n). The mono "HTTP {status}" badge stays outside translation.
let errHeadKey: string = "";
let errDetailKey: string = "";
let merchantAddr: string = "";
let mintAddr: string = "";
let amountRaw: string = "0";
let amountUi: string = "—";
let periodUi: string = "—";
let planIdUi: string = "—";
let subscribeEndpoint: string = "";
let isDemoPlan = false;
// One-time mode values (populated only when payMode):
let payMerchant = "";
let payMint: string | null = null;
let payAmount = 0n;
let payAmountUi = "";
let payLabel = "";
let payMemo = "";
let isDemoPay = false;
/** Token decimals for the one-time amount (null = unknown: no UI-amount URL). */
let payDecimals: number | null = null;
/** Solana Pay transfer-request URL, or null when it cannot be built honestly. */
let solanaPayUrl: string | null = null;
/** Base58 Solana address shape (merchant/mint params of ?mode=pay). */
const PAY_ADDR_RE = /^[1-9A-HJ-NP-Za-km-z]{32,44}$/;
/** u64 upper bound for the raw amount param. BigInt via string, NOT a hex
 * `…n` literal: @astrojs/compiler 2.13.1 mis-scans hex BigInt literals and
 * then leaves a duplicate `export const prerender` inside the component body,
 * which esbuild rejects at build time ("Unexpected export"). */
const U64_MAX = BigInt("0xffffffffffffffff");
// Visible value for the fallback tab only: the PUBLIC override when set,
// otherwise the same-origin proxy path. The SSR-internal default
// (BACKEND_URL/host.docker.internal) must never reach the markup — the
// browser resolves its own endpoint client-side (see the script below).
const displayRpc = readEnv("PUBLIC_SOLANA_RPC", "").length > 0 ? readEnv("PUBLIC_SOLANA_RPC", "") : "/api/rpc";

if (payMode) {
  // One-time branch: validate the link params here, no widget /check and no
  // plan RPC read. Demo mode (?demo=1) renders the card with payments
  // disabled — no fixtures, no fetch (global demo rule).
  isDemoPay = demoParam;
  const merchantParam = (Astro.url.searchParams.get("merchant") ?? "").trim();
  const amountParam = (Astro.url.searchParams.get("amount") ?? "").trim();
  const mintParam = (Astro.url.searchParams.get("mint") ?? "").trim();
  const labelParam = (Astro.url.searchParams.get("label") ?? "").trim();
  const memoParam = (Astro.url.searchParams.get("memo") ?? "").trim();
  const badLink = (): void => {
    status = 400;
    headline = "Invalid payment link";
    detail = "Expected ?mode=pay&merchant=<address>&amount=<base units>.";
    errHeadKey = "payerr.payBadHeadline";
    errDetailKey = "payerr.payBadDetail";
  };
  if (!PAY_ADDR_RE.test(merchantParam)) {
    badLink();
  } else if (!/^\d+$/.test(amountParam) || amountParam === "0" || BigInt(amountParam) > U64_MAX) {
    badLink();
  } else if (mintParam !== "" && !PAY_ADDR_RE.test(mintParam)) {
    badLink();
  } else if (
    (labelParam !== "" && (labelParam.length > 120 || /[\u0000-\u001f\u007f]/.test(labelParam))) ||
    (memoParam !== "" && (memoParam.length > 200 || /[\u0000-\u001f\u007f]/.test(memoParam)))
  ) {
    badLink();
  } else {
    try {
      payMerchant = new PublicKey(merchantParam).toBase58();
    } catch {
      badLink();
    }
  }
  if (status === 200) {
    payAmount = BigInt(amountParam);
    payMint = mintParam === "" ? null : mintParam;
    payLabel = labelParam;
    payMemo = memoParam;
    merchantAddr = payMerchant;
    amountRaw = amountParam;
    // Big display amount: native SOL is always 9 decimals (protocol constant);
    // token decimals come from the chain — never from the URL. When the RPC
    // is unreachable the raw base-unit count stays visible (honest fallback),
    // because the actions endpoint re-reads decimals itself at build time.
    if (payMint === null) {
      payDecimals = 9;
      payAmountUi = formatTokenAmount(payAmount, 9);
    } else if (isDemoPay) {
      payDecimals = null;
      payAmountUi = `${amountParam} base units`;
    } else {
      try {
        const conn = new Connection(RPC_ENDPOINT, "confirmed");
        payDecimals = await fetchMintDecimals(conn, new PublicKey(payMint));
        payAmountUi = formatTokenAmount(payAmount, payDecimals);
      } catch {
        payDecimals = null;
        payAmountUi = `${amountParam} base units`;
      }
    }
  }
} else if (demoParam) {
  const d = DEMO_PLANS[0];
  if (d === undefined) {
    status = 500;
    headline = "Demo unavailable";
    detail = "Demo fixtures failed to load. Retry or continue without ?demo=1.";
    errHeadKey = "payerr.demoHeadline";
    errDetailKey = "payerr.demoDetail";
  } else {
    isDemoPlan = true;
    merchantAddr = d.merchant;
    mintAddr = d.mintSymbol;
    amountRaw = d.amountUi;
    amountUi = `${d.amountUi} ${d.mintSymbol}`;
    periodUi = d.periodLabel;
    planIdUi = d.planId;
    subscribeEndpoint = "";
  }
} else if (planParam === "") {
  status = 400;
  headline = "Missing plan";
  detail = "Open this checkout through a merchant site (expected ?plan=<address>&host=<domain>).";
  errHeadKey = "payerr.missingPlanHeadline";
  errDetailKey = "payerr.missingPlanDetail";
} else {
  let allowed = false;
  try {
    const res = await fetch(
      `${backendBase()}/api/widget/check?plan=${encodeURIComponent(planParam)}&host=${encodeURIComponent(hostParam)}`,
    );
    if (res.ok) {
      allowed = ((await res.json()) as { allowed?: boolean }).allowed === true;
    } else {
      status = 502;
      headline = "Checkout unavailable";
      detail = "The domain-bind service is unreachable. Try again in a moment.";
      errHeadKey = "payerr.gateDownHeadline";
      errDetailKey = "payerr.gateDownDetail";
    }
    if (status === 200 && !allowed) {
      status = 403;
      headline = "This site is not allowed to sell this plan";
      detail =
        "Domain-bind: the merchant registered this plan for their own domain only. " +
        "A copied snippet on a foreign domain always ends here (403).";
      // Same copy as the 403 mock panel — reuse the flows2 keys, no duplicates.
      errHeadKey = "flows2.blockHeadline";
      errDetailKey = "flows2.blockBody";
    }
  } catch {
    status = 502;
    headline = "Checkout unavailable";
    detail = "The domain-bind service is unreachable. Try again in a moment.";
    errHeadKey = "payerr.gateDownHeadline";
    errDetailKey = "payerr.gateDownDetail";
  }

  if (status === 200) {
    try {
      const conn = new Connection(RPC_ENDPOINT, "confirmed");
      const key = new PublicKey(planParam);
      const info = await conn.getAccountInfo(key);
      const decoded = info === null ? null : decodePlan(key, info.data);
      if (decoded === null) {
        status = 404;
        headline = "Plan not found";
        detail = "No plan account exists at this address on the configured cluster.";
        errHeadKey = "payerr.planNotFoundHeadline";
        errDetailKey = "payerr.planNotFoundDetail";
      } else {
        const decimals = await fetchMintDecimals(conn, decoded.mint);
        merchantAddr = decoded.merchant.toBase58();
        mintAddr = decoded.mint.toBase58();
        amountRaw = decoded.amount.toString();
        amountUi = `${formatTokenAmount(decoded.amount, decimals)} (raw ${amountRaw})`;
        periodUi = formatPeriod(decoded.periodSeconds);
        planIdUi = decoded.planId.toString();
        const qs = new URLSearchParams({
          plan: planParam,
          mint: mintAddr,
          amount: amountRaw,
          programId: PROGRAM_ID.toBase58(),
          cluster: CLUSTER,
        });
        subscribeEndpoint = `/api/actions/subscribe?${qs.toString()}`;
      }
    } catch {
      status = 502;
      headline = "Chain read failed";
      detail = "Could not load the plan from RPC. Check the cluster and retry.";
      errHeadKey = "payerr.chainDownHeadline";
      errDetailKey = "payerr.chainDownDetail";
    }
  }
}

// Solana Pay transfer-request URL for the one-time card: recipient + amount
// are known here with real token decimals, so the URL is built once on the
// server. Demo mode builds no transaction (row hidden); unknown SPL decimals
// or a builder throw also hide the row — no data = empty state, never a
// fake link.
if (payMode && status === 200 && !isDemoPay && payDecimals !== null) {
  try {
    const ui = Number.parseFloat((Number(payAmount) / 10 ** payDecimals).toFixed(payDecimals));
    solanaPayUrl = buildTransferUrl({
      recipient: payMerchant,
      uiAmount: ui,
      ...(payLabel !== "" ? { label: payLabel } : {}),
      ...(payMemo !== "" ? { memo: payMemo } : {}),
    });
  } catch {
    solanaPayUrl = null;
  }
}

if (status !== 200) Astro.response.status = status;

const displayHost = hostParam === "" ? "— (no host param)" : hostParam;
const demo0 = DEMO_PLANS[0];
const demoAddress = demo0 === undefined ? "DEMO" : demo0.address;
let planShort = "—";
if (isDemoPlan) {
  planShort = `${demoAddress.slice(0, 6)}… (demo)`;
} else if (status === 200 && planParam !== "") {
  try {
    planShort = `${shortAddr(new PublicKey(planParam), 6)}…`;
  } catch {
    planShort = "—";
  }
}
let merchantShort = "—";
if (merchantAddr !== "") {
  if (isDemoPlan) {
    merchantShort = `${merchantAddr.slice(0, 6)}… (demo)`;
  } else {
    try {
      merchantShort = `${shortAddr(new PublicKey(merchantAddr), 6)}…`;
    } catch {
      merchantShort = "—";
    }
  }
}
const fallbackPlan = isDemoPlan ? demoAddress : planParam === "" ? "<PLAN>" : planParam;
const fallbackAction = `/api/actions/subscribe?plan=${encodeURIComponent(fallbackPlan)}`;
// One canonical origin for shareable Action URLs (PUBLIC_SITE_URL, same
// source as blinks.ts blinkUrl/subscribeActionUrl) — the request origin
// varies with Host forwarding behind the tunnel/proxy.
const fullActionUrl = `${SITE_URL}${fallbackAction}`;
// Explorer deep link for the merchant row (address-poisoning copy-verify);
// demo fixtures are not on-chain accounts → no link for them.
const explorerAddrUrl =
  merchantAddr === "" || isDemoPlan
    ? null
    : CLUSTER === "mainnet-beta"
      ? `https://explorer.solana.com/address/${merchantAddr}`
      : `https://explorer.solana.com/address/${merchantAddr}?cluster=${CLUSTER}`;
// Real on-chain program id, shortened for the header status tray.
const programIdFull = PROGRAM_ID.toBase58();
const programIdShort = `${programIdFull.slice(0, 6)}…${programIdFull.slice(-4)}`;
---

<Layout title={status === 200 ? (payMode ? (payLabel !== "" ? payLabel : "One-time payment") : "Checkout") : headline} description="OnchainSUB checkout — one-time payment or domain-bound subscription with attack simulator.">
  <!-- =========================================================================
       ONE-TIME MODE (?mode=pay): a plain-transfer checkout card. The server
       builds an unsigned SystemProgram.transfer / SPL transferChecked at
       /api/actions/pay; the wallet is the only signer. No plan gate, no
       domain-bind — the explorer links below are real params of this link.
       ========================================================================= -->
  {payMode && (
    <section class="mx-auto max-w-3xl pt-12 pb-12">
      <div class="min-w-0">
        <p class="w-fit rounded-full bg-[#282934] px-2.5 py-1 font-mono text-[11px] tracking-[0.06em] text-[#14f195] uppercase" data-i18n="pay1.eyebrow">
          one-time payment · direct transfer
        </p>
        <h1 class="font-display mt-2 text-3xl font-bold tracking-tight sm:text-4xl" data-i18n="pay1.h1">
          One-time payment
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/55 sm:text-[15px]" data-i18n="pay1.lead">
          A plain Solana transfer you sign in your wallet — one-time payment, no recurring charges. No delegate, no
          subscription, no stored allowance. The server builds the transaction; it never signs it.
        </p>
      </div>

      {
        status === 400 ? (
          <div class="mt-6 rounded-2xl bg-[#282934] p-8 text-center ring-2 ring-[#93000a]">
            <p class="font-mono text-[11px] tracking-wider text-[#ffb4ab]/70 uppercase">HTTP {status}</p>
            <h2 class="font-display mt-3 text-2xl font-bold tracking-tight text-[#ffb4ab]" data-i18n={errHeadKey}>{headline}</h2>
            <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-white/55" data-i18n={errDetailKey}>{detail}</p>
            <pre class="codeblock mx-auto mt-4 max-w-xl overflow-x-auto text-left font-mono text-[11px] break-all whitespace-pre-wrap text-white/45">/pay?mode=pay&amp;merchant=&lt;address&gt;&amp;amount=&lt;base units&gt;&amp;[mint=&lt;address&gt;&amp;label=&amp;memo=]</pre>
          </div>
        ) : (
      <div class="mt-6 rounded-2xl bg-[#282934] p-6 shadow-xl sm:p-8" data-pay-card>
        <div class="flex items-center justify-between rounded-t-xl bg-[#32343f]/20 px-2 pt-1">
          <div class="flex items-center gap-2">
            <span class="font-display text-sm font-semibold text-white/90" data-i18n="pay1.cardTitle">One-time checkout</span>
          </div>
          {isDemoPay && <span class="tag-pill">DEMO</span>}
        </div>
        <!-- Big amount — the one number this page sells. Label (merchant-chosen)
             sits above; base units stay visible below it (honest raw view). -->
        <div class="mt-4 min-w-0 rounded-xl bg-[#1d1f29] p-5 text-center">
          {payLabel !== "" && <p class="font-display break-words text-base text-white/85">{payLabel}</p>}
          <div class="font-display mt-1 text-4xl font-bold tracking-tight break-words text-[#d8b9ff] sm:text-5xl">{payAmountUi}</div>
          <p class="mt-1 font-mono text-[11px] tracking-wider text-white/35 uppercase">
            {payMint === null ? "SOL" : "SPL"} · {amountRaw} base units
          </p>
        </div>
        <div class="mt-3 space-y-3">
          <!-- Address-poisoning defense (copy-verify): full address via the
               copy button, short form display-only, Explorer when live. -->
          <div class="flex items-center justify-between gap-2 rounded-lg bg-[#32343f]/30 px-3 py-2 text-sm">
            <span class="shrink-0 text-white/55" data-i18n="pay1.merchantRow">Merchant</span>
            <span class="flex min-w-0 items-center justify-end gap-1.5">
              <span class="truncate font-mono text-[13px] font-semibold text-white/90" title={payMerchant || undefined}>{merchantShort}</span>
              <button
                type="button"
                id="pay1-copy-merchant"
                class="shrink-0 cursor-pointer rounded p-0.5 text-white/45 transition-colors hover:text-[#00f0ff]"
                data-addr={payMerchant}
                data-i18n-title="paysim.copyMerchantTitle"
                title="Copy the full merchant address and verify it in your wallet."
              >
                <span class="msym text-[14px]" aria-hidden="true">content_copy</span>
                <span class="sr-only" data-i18n="paysim.copyMerchantSr">Copy merchant address</span>
              </button>
              {explorerAddrUrl !== null && (
                <a
                  href={explorerAddrUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="shrink-0 rounded p-0.5 text-white/45 transition-colors hover:text-[#00dbe9]"
                  data-i18n-title="paysim.explorerTitle"
                  title="Open the merchant address in the Solana Explorer."
                >
                  <span class="msym text-[14px]" aria-hidden="true">open_in_new</span>
                  <span class="sr-only" data-i18n="paysim.explorerSr">Merchant address on Explorer</span>
                </a>
              )}
            </span>
          </div>
          <div class="flex items-center justify-between gap-2 rounded-lg bg-[#32343f]/30 px-3 py-2 text-sm">
            <span class="shrink-0 text-white/55" data-i18n="pay1.assetRow">Asset</span>
            {payMint === null ? (
              <span class="min-w-0 truncate font-mono text-[13px] text-white/90" data-i18n="pay1.assetSol">SOL (native)</span>
            ) : (
              <span class="min-w-0 truncate font-mono text-[13px] text-white/90">
                <span title={payMint}>{payMint.slice(0, 8)}…</span> <span class="text-white/45" data-i18n="pay1.splToken">SPL token</span>
              </span>
            )}
          </div>
          {payMemo !== "" && (
            <div class="flex items-center justify-between gap-2 rounded-lg bg-[#32343f]/30 px-3 py-2 text-sm">
              <span class="shrink-0 text-white/55" data-i18n="pay1.memoRow">Memo</span>
              <span class="min-w-0 truncate font-mono text-[13px] text-white/90">{payMemo}</span>
            </div>
          )}
          {solanaPayUrl !== null && (
            <div class="flex items-center justify-between gap-2 rounded-lg bg-[#32343f]/30 px-3 py-2 text-sm">
              <span class="shrink-0 text-white/55" data-i18n="pay1.solpayRow">Solana Pay</span>
              <span class="flex min-w-0 items-center justify-end gap-1.5">
                <a
                  href={solanaPayUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="min-w-0 truncate font-mono text-[13px] text-[#7df4ff] transition-colors hover:text-[#00f0ff] hover:underline"
                  data-i18n="pay1.openWallet"
                >Open in wallet</a>
                <button
                  type="button"
                  id="pay1-copy-solpay"
                  class="shrink-0 cursor-pointer rounded p-0.5 text-white/45 transition-colors hover:text-[#00f0ff]"
                  data-url={solanaPayUrl}
                  data-i18n-title="pay1.copySolpayTitle"
                  title="Copy the Solana Pay URL to share or open in your wallet."
                >
                  <span class="msym text-[14px]" aria-hidden="true">content_copy</span>
                  <span class="sr-only" data-i18n="pay1.copySolpaySr">Copy Solana Pay URL</span>
                </button>
              </span>
            </div>
          )}
          <div class="flex items-center justify-between rounded-lg bg-[#32343f]/30 px-3 py-2 text-sm">
            <span class="text-white/55" data-i18n="port4.payModelRow">Payment model</span>
            <span class="rounded bg-[#14f195]/10 px-2 py-0.5 text-right font-mono text-[11px] text-[#14f195]" data-i18n="pay1.modelV">Direct transfer — no delegate, no custody</span>
          </div>
        </div>
        <div class="mt-5 grid gap-2">
          {isDemoPay ? (
            <button type="button" class="btn-primary flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-lg px-4 py-4 text-sm opacity-60" disabled>
              <span class="msym text-[20px]" aria-hidden="true">lock_open</span>
              <span data-i18n="pay1.demoDisabled">Pay (disabled in demo — no transaction is built)</span>
            </button>
          ) : (
            <button
              id="pay1-send"
              type="button"
              class="btn-primary flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg px-4 py-4 text-sm"
              data-merchant={payMerchant}
              data-amount={amountRaw}
              data-mint={payMint ?? ""}
              data-label={payLabel}
              data-memo={payMemo}
            >
              <span class="msym text-[20px]" aria-hidden="true">bolt</span>
              <span data-i18n="pay1.payCta">Pay</span>
            </button>
          )}
          <p class="mt-1 text-center text-xs text-white/40" data-i18n="pay1.hint">
            You sign exactly one transfer — no recurring charges. Funds go straight to the merchant's wallet.
          </p>
        </div>
        <p id="pay1-status" class="mt-1 min-h-5 text-center text-xs text-white/50" role="status" />
        <!-- Confirmation screen (hidden until the transfer lands): honest
             signature + Explorer deep link, plus a warning when the receipt
             service failed to record the (already final) payment. -->
        <div id="pay1-success" class="mt-4 hidden space-y-2 rounded-xl bg-[#0c0e17] p-5 ring-1 ring-[#14f195]/40">
          <div class="flex items-center gap-2">
            <span class="msym text-[20px] text-[#14f195]" aria-hidden="true">check_circle</span>
            <h2 class="font-display text-lg font-bold text-white/90" data-i18n="pay1.successTitle">Payment confirmed</h2>
          </div>
          <p class="text-[13px] text-white/55" data-i18n="pay1.successLead">The transfer is confirmed on-chain. Verify it in the Explorer:</p>
          <p id="pay1-sig" class="codeblock break-all">—</p>
          <p id="pay1-record-warn" class="hidden rounded bg-[#ffb4ab]/10 p-2 font-mono text-[11px] leading-relaxed text-[#ffb4ab]" data-i18n="pay1.recordWarn">
            The on-chain payment is confirmed, but the receipt service did not record it — the transfer itself is complete.
          </p>
          <a id="pay1-explorer" href="#" target="_blank" rel="noreferrer" class="btn-ghost inline-flex w-full items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm">
            <span class="msym text-[18px]" aria-hidden="true">open_in_new</span>
            <span data-i18n="pay1.viewExplorer">View in Explorer</span>
          </a>
        </div>
      </div>
      )
      }
    </section>
  )}

  {!payMode && (
  <section class="mx-auto max-w-6xl pt-12 pb-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0">
        <p class="w-fit rounded-full bg-[#282934] px-2.5 py-1 font-mono text-[11px] tracking-[0.06em] text-[#00dbe9] uppercase" data-i18n="paysim.eyebrow">
          checkout · domain-bound execution
        </p>
        <h1 class="font-display mt-2 text-3xl font-bold tracking-tight sm:text-4xl" data-i18n="paysim.h1">
          Embeddable Checkout & Domain Protection
        </h1>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-white/55 sm:text-[15px]" data-i18n="paysim.lead">
          Interactive execution-environment simulator. Tab 1 runs the real server-gated checkout below. Tabs 2–3 are
          labelled mock previews: they never change the host, never touch the server gate — they show what an attacker
          (or an outage) would see.
        </p>
      </div>
      <!-- Status tray (Stitch header pattern) — real values only: program id from
           the chain lib and the host param from this request. No fixtures. -->
      <div class="hidden shrink-0 items-center gap-3 rounded-xl bg-[#191b25] p-2 lg:flex">
        <div class="flex items-center gap-2 rounded-lg bg-[#1d1f29] px-3 py-1.5">
          <span class="msym text-[18px] text-[#56ffa8]" aria-hidden="true">verified</span>
          <div class="flex min-w-0 flex-col">
