<script is:inline src="/widget.js"></script>
<script>
  import { isDemoMode } from "../lib/demo.js";
  import "../lib/i18n-flows2.js";
  import "../lib/i18n-pay.js";
  import "../lib/i18n-port4.js";
  import "../lib/i18n-proofs.js";

  try {
    const qs = new URLSearchParams(window.location.search);
    if (isDemoMode() && !qs.has("demo")) {
      qs.set("demo", "1");
      window.location.replace(`${window.location.pathname}?${qs.toString()}`);
    }
  } catch {
    /* private mode — session-only */
  }

  function logLine(text: string): void {
    const log = document.getElementById("observer-log");
    if (log === null) return;
    const p = document.createElement("p");
    p.textContent = text;
    log.appendChild(p);
  }

  const btn = document.getElementById("live-subscribe") as HTMLButtonElement | null;
  const plan = btn instanceof HTMLElement ? (btn.dataset.plan ?? "") : "";
  const demo = btn instanceof HTMLElement && btn.dataset.demo === "1";
  const receiptId = document.getElementById("observer-log")?.dataset.receiptId ?? "";
  const receiptSig = document.getElementById("observer-log")?.dataset.receiptSig ?? "";

  // Case cards are anchors to #live-widget (step 1 → step 2 of the flow).
  // Upgrade the native jump to a smooth scroll; without JS the anchor still works.
  for (const card of document.querySelectorAll<HTMLAnchorElement>('#use-cases-grid a[href="#live-widget"]')) {
    card.addEventListener("click", (e) => {
      const target = document.getElementById("live-widget");
      if (target === null) return; // native anchor jump
      e.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  const isPl = (): boolean => document.documentElement.lang === "pl";
  const T = {
    opening: (): string => (isPl() ? "Otwieranie checkoutu…" : "Opening checkout…"),
    widgetFail: (): string => (isPl() ? "Widget się nie wczytał." : "Widget failed to load."),
    demoStatus: (id: string): string =>
      isPl() ? `DEMO checkout — fikcyjny paragon ${id} (bez popupu, bez fetcha).` : `DEMO checkout — fixture receipt ${id} (no popup, no fetch).`,
    demoLog: (sig: string): string =>
      isPl() ? `[DEMO] fikcyjne zatwierdzenie z limitem 1 okresu → ${sig}` : `[DEMO] fixture approval capped at 1 period → ${sig}`,
    widgetFailLog: (): string => (isPl() ? "Widget się nie wczytał." : "Widget failed to load."),
    openingLog: (): string => (isPl() ? "Otwieranie popupu checkout…" : "Opening popup checkout…"),
    paidLog: (sig: string): string => (isPl() ? "Zapłacono: " + sig : "Paid: " + sig),
  };

  btn?.addEventListener("click", async function () {
    const status = document.getElementById("live-status");
    if (demo || (isDemoMode() && plan !== "")) {
      if (status !== null) status.textContent = T.demoStatus(receiptId);
      logLine(T.demoLog(receiptSig));
      return;
    }
    const w = window as unknown as {
      SolhackPay?: { subscribe: (opts: { plan: string }) => Promise<string> };
    };
    if (w.SolhackPay === undefined) {
      if (status !== null) status.textContent = T.widgetFail();
      logLine(T.widgetFailLog());
      return;
    }
    // Single flight: the button stays disabled until the popup settles, so a
    // double-click can never open two checkouts (pattern: lib/pay-checkout.ts).
    if (btn !== null) btn.disabled = true;
    if (status !== null) status.textContent = T.opening();
    logLine(T.openingLog());
    try {
      const sig = await w.SolhackPay.subscribe({ plan: plan });
      if (status !== null) status.textContent = T.paidLog(sig);
      logLine(T.paidLog(sig));
    } catch (err) {
      const msg = err instanceof Error ? err.message : "Checkout closed.";
      if (status !== null) status.textContent = msg;
      logLine(msg);
    } finally {
      if (btn !== null) btn.disabled = false;
    }
  });
</script>
