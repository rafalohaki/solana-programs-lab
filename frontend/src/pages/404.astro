---
// Custom 404: server-rendered like every route (output: "server"), so both
// unknown URLs and a direct /404 visit render the real layout. (A prerendered
// 404 has no SSR page function under the standalone adapter → direct /404 500s.)
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="This address does not exist on Iugis.">
  <section class="mx-auto flex max-w-3xl flex-col items-center pt-24 pb-32 text-center">
    <p class="font-mono text-[11px] tracking-[0.06em] text-white/50 uppercase" data-i18n="nf.eyebrow">http 404 · not found</p>
    <h1 class="font-display mt-2 text-3xl font-bold tracking-tight sm:text-4xl" data-i18n="nf.title">Page not found</h1>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/55 sm:text-[15px]" data-i18n="nf.lead">
      This address does not exist on Iugis. If you followed a Blink or Action link, the plan behind it may
      be gone — check the URL or browse the live plans.
    </p>
    <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href="/" class="btn-stitch inline-flex w-full items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm sm:w-auto">
        <span class="msym text-[18px]" aria-hidden="true">subscriptions</span>
        <span data-i18n="nf.backPlans">Browse live plans</span>
      </a>
      <a href="/blink" class="btn-secondary inline-flex w-full items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm sm:w-auto">
        <span class="msym text-[18px]" aria-hidden="true">bolt</span>
        <span data-i18n="nf.backBlinks">Open the Blink builder</span>
      </a>
    </div>
  </section>
</Layout>
