# Baked into the client bundle at build time (bun run build).
# Must match the deployed program; placeholder until `anchor deploy`.
PUBLIC_SUBSCRIPTIONS_PROGRAM_ID=SubScribe1111111111111111111111111111111111
PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
PUBLIC_SOLANA_CLUSTER=devnet
# Canonical origin of this deployment (used to build Blink URLs).
PUBLIC_SITE_URL=https://solhack.rafal.si
# NOTE: BACKEND_URL is server-only — read via `process.env` in
# src/pages/api/[...path].ts. NEVER prefix it with PUBLIC_ (`import.meta.env`
# would leak the internal backend address into the client bundle).
# Local dev: BACKEND_URL=http://localhost:3001
# Compose:   BACKEND_URL=http://backend:3001 (see compose.yml)
# BACKEND_URL=http://localhost:3001
# Server-only mail compliance footer (backend/src/mail.ts, docs/LEGAL-COMPLIANCE.md §4).
# NEVER prefix with PUBLIC_ — must not leak into the client bundle.
# Empty = legacy footer (receipt still sends; owner fills real data).
BUSINESS_NAME=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=
