    {
      "id": "03_mechanism",
      "label": "Mechanism",
      "eyebrow": "model b \u00b7 delegate, not custody",
      "startFrame": 669,
      "durationInFrames": 1215,
      "voOffsetInFrames": 9,
      "voDurationInFrames": 1137,
      "start": 22.3,
      "end": 62.8,
      "beats": [
        {
          "frame": 9,
          "text": "The merchant creates a plan: amount and period written to the chain once, immutably."
        },
        {
          "frame": 173,
          "text": "The subscriber approves the subscription account as a token delegate, capped at one period, then signs subscribe."
        },
        {
          "frame": 389,
          "text": "On charge day the merchant calls charge. Charge takes no amount argument: it reads the amount from the immutable plan, then C P I's transfer checked, signed by the subscription P D A. That blocks overcharge structurally."
        },
        {
          "frame": 852,
          "text": "Forty basis points. Funds stay in the subscriber's wallet until charge day, and cancel revokes the delegate, so cancellation can never be bricked."
        }
      ]
    },
